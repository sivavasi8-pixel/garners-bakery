# Copy this file to .env and fill in your real values. .env is gitignored.

# Neon/Supabase Postgres connection string, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign login tokens. Any long random string works for dev.
JWT_SECRET=
