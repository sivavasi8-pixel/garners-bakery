# Copy this file to .env and fill in your real values. .env is gitignored.

# Neon/Supabase Postgres connection string, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign login tokens. Any long random string works for dev.
JWT_SECRET=

# Firebase service-account credential (Firebase Console → garners-bakery project
# → Project Settings → Service Accounts → Generate new private key), pasted in
# as the ENTIRE contents of the downloaded .json file, as one line. Powers push
# notifications (server/config/firebaseAdmin.js); the app runs fine without it
# — push notifications just stay disabled until this is set.
FIREBASE_SERVICE_ACCOUNT=
